# Mini PaaS — environment for docker compose.
# Copy to .env. Nothing here is secret: real secrets are generated per installation by the
# `secrets-init` service into the paas-secrets volume. Set a value below only to override.

# --- general ---------------------------------------------------------------
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# host port Traefik listens on
HTTP_PORT=80

# --- domains ---------------------------------------------------------------
# dashboard + API:  http://localhost
PLATFORM_HOST=localhost
# apps:             http://<slug>.localhost
APPS_BASE_DOMAIN=localhost
PUBLIC_SCHEME=http
# set when HTTP_PORT is not 80, e.g. 8080
PUBLIC_PORT=
# true behind HTTPS
COOKIE_SECURE=false

# --- database --------------------------------------------------------------
POSTGRES_USER=minipaas
POSTGRES_DB=minipaas
# DATABASE_URL=                  # optional full URL (overrides the parts + generated password)

# --- optional secret overrides (leave empty to use generated values) ------
JWT_SECRET=
# comma separated Fernet keys; first one encrypts
ENCRYPTION_KEYS=
INTERNAL_API_TOKEN=

# --- seed ------------------------------------------------------------------
# empty: a random password is printed by `make seed`
SEED_DEMO_PASSWORD=

# --- docker ----------------------------------------------------------------
# The worker and agent use the host daemon through /var/run/docker.sock (see README).
# DOCKER_HOST=unix:///var/run/docker.sock
